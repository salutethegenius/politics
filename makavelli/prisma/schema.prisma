// This is the canonical Postgres schema for Makavelli.
// Neo4j is a projection of this schema optimized for graph queries.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @unique
  fullName   String?
  avatarUrl  String?
  role       String   @default("owner")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  nodes      Node[]
  tasks      Task[]
  meetings   Meeting[]
  documents  Document[]
  researches Research[]
  projects   Project[]
  opportunities Opportunity[]

  @@map("users")
}

model NodeType {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  icon      String?
  color     String?
  schema    Json?
  createdAt DateTime @default(now()) @map("created_at")

  nodes Node[]

  @@map("node_types")
}

model Node {
  id                   String   @id @default(uuid()) @db.Uuid
  typeId               String   @map("type_id") @db.Uuid
  ownerId              String   @map("owner_id") @db.Uuid
  organizationId       String?  @map("organization_id") @db.Uuid
  name                 String
  summary              String?
  properties           Json?    @default("{}")
  status               String   @default("active")
  trustLevel           Int?     @map("trust_level")
  relationshipStrength Int?     @map("relationship_strength")
  lastMeetingAt        DateTime? @map("last_meeting_at")
  nextFollowUpAt       DateTime? @map("next_follow_up_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")

  type         NodeType        @relation(fields: [typeId], references: [id])
  owner        User            @relation(fields: [ownerId], references: [id])
  outgoing     Relationship[]  @relation("source")
  incoming     Relationship[]  @relation("target")
  tasks        Task[]
  documents    Document[]
  meetings     MeetingAttendee[]
  researches   Research[]
  projects     Project[]
  opportunitiesAsCustomer Opportunity[] @relation("customer")
  opportunities           Opportunity[]

  @@index([typeId])
  @@index([ownerId])
  @@index([status])
  @@index([nextFollowUpAt])
  @@map("nodes")
}

model Relationship {
  id         String   @id @default(uuid()) @db.Uuid
  sourceId   String   @map("source_id") @db.Uuid
  targetId   String   @map("target_id") @db.Uuid
  type       String
  properties Json?    @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  source Node @relation("source", fields: [sourceId], references: [id])
  target Node @relation("target", fields: [targetId], references: [id])

  @@index([sourceId])
  @@index([targetId])
  @@index([type])
  @@map("relationships")
}

model Task {
  id          String    @id @default(uuid()) @db.Uuid
  ownerId     String    @map("owner_id") @db.Uuid
  nodeId      String?   @map("node_id") @db.Uuid
  title       String
  description String?
  status      String    @default("todo")
  priority    Int       @default(2)
  dueDate     DateTime? @map("due_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id])
  node  Node? @relation(fields: [nodeId], references: [id])

  @@index([ownerId])
  @@index([nodeId])
  @@map("tasks")
}

model Meeting {
  id          String    @id @default(uuid()) @db.Uuid
  ownerId     String    @map("owner_id") @db.Uuid
  title       String
  scheduledAt DateTime  @map("scheduled_at")
  durationMinutes Int?  @map("duration_minutes")
  notes       String?
  outcome     String?
  aiSummary   String?   @map("ai_summary")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  owner     User            @relation(fields: [ownerId], references: [id])
  attendees MeetingAttendee[]

  @@index([ownerId])
  @@index([scheduledAt])
  @@map("meetings")
}

model MeetingAttendee {
  id        String @id @default(uuid()) @db.Uuid
  meetingId String @map("meeting_id") @db.Uuid
  nodeId    String @map("node_id") @db.Uuid
  role      String @default("attendee")

  meeting Meeting @relation(fields: [meetingId], references: [id])
  node    Node    @relation(fields: [nodeId], references: [id])

  @@map("meeting_attendees")
}

model Document {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  nodeId    String?  @map("node_id") @db.Uuid
  title     String
  content   String?
  fileUrl   String?  @map("file_url")
  docType   String   @default("note") @map("doc_type")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id])
  node  Node? @relation(fields: [nodeId], references: [id])

  @@index([ownerId])
  @@index([nodeId])
  @@map("documents")
}

model Research {
  id           String   @id @default(uuid()) @db.Uuid
  nodeId       String   @map("node_id") @db.Uuid
  ownerId      String   @map("owner_id") @db.Uuid
  problem      String
  hypothesis   String?
  dataSources  String[] @map("data_sources")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  node  Node @relation(fields: [nodeId], references: [id])
  owner User @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([nodeId])
  @@map("researches")
}

model Project {
  id        String    @id @default(uuid()) @db.Uuid
  nodeId    String    @map("node_id") @db.Uuid
  ownerId   String    @map("owner_id") @db.Uuid
  vision    String?
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  budget    Decimal?  @db.Decimal(12, 2)
  status    String    @default("planning")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  node  Node @relation(fields: [nodeId], references: [id])
  owner User @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([nodeId])
  @@map("projects")
}

model Opportunity {
  id             String    @id @default(uuid()) @db.Uuid
  nodeId         String    @map("node_id") @db.Uuid
  ownerId        String    @map("owner_id") @db.Uuid
  customerNodeId String    @map("customer_node_id") @db.Uuid
  problem        String
  solution       String?
  estimatedValue Decimal?  @map("estimated_value") @db.Decimal(12, 2)
  status         String    @default("discovery")
  probability    Int       @default(20)
  nextAction     String?   @map("next_action")
  nextActionDate DateTime? @map("next_action_date")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  node     Node @relation(fields: [nodeId], references: [id])
  owner    User @relation(fields: [ownerId], references: [id])
  customer Node @relation("customer", fields: [customerNodeId], references: [id])

  @@index([ownerId])
  @@index([nodeId])
  @@index([customerNodeId])
  @@map("opportunities")
}

model ActivityLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  nodeId    String?  @map("node_id") @db.Uuid
  action    String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([nodeId])
  @@index([createdAt])
  @@map("activity_log")
}
